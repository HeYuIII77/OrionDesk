<local:BaseWidgetWindow x:Class="OrionDesk.UI.Windows.CalendarWidget"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:OrionDesk.UI.Windows"
        Title="日历事项"
        Background="Transparent">
    <Window.Resources>
        <!-- 日期格子按钮样式 -->
        <Style x:Key="DayButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Padding" Value="2"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" Background="{TemplateBinding Background}"
                                CornerRadius="4" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Stretch" VerticalAlignment="Stretch"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#22FFFFFF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Border Style="{StaticResource GlassBackground}">
        <Border.ContextMenu>
            <ContextMenu>
                <MenuItem x:Name="LockMenuItem" Header="锁定" Click="Lock_Click"/>
                <Separator/>
                <MenuItem Header="关闭组件" Click="Close_Click"/>
            </ContextMenu>
        </Border.ContextMenu>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>   <!-- 标题栏 -->
                <RowDefinition Height="Auto"/>   <!-- 星期头 -->
                <RowDefinition Height="*"/>      <!-- 日期网格 -->
                <RowDefinition Height="Auto"/>   <!-- 倒计时区 -->
            </Grid.RowDefinitions>

            <!-- 标题栏：月份导航 -->
            <Grid Grid.Row="0" Margin="0,0,0,6">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Left" VerticalAlignment="Center">
                    <Button x:Name="LockButton" Content="🔓"
                            Style="{StaticResource LockButtonStyle}"
                            Click="Lock_Click" ToolTip="锁定"/>
                    <Button x:Name="TodayButton" Content="今天"
                            Style="{StaticResource LockButtonStyle}" FontSize="11"
                            Click="Today_Click" ToolTip="回到今天" Margin="4,0,0,0"/>
                </StackPanel>

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                    <Button x:Name="PrevMonthButton" Content="◀" Style="{StaticResource LockButtonStyle}"
                            Click="PrevMonth_Click" ToolTip="上一月" FontSize="10"/>
                    <TextBlock x:Name="MonthTitle" Text="2026年8月"
                               Foreground="White" FontSize="13" FontWeight="SemiBold"
                               Margin="8,0,8,0" VerticalAlignment="Center"/>
                    <Button x:Name="NextMonthButton" Content="▶" Style="{StaticResource LockButtonStyle}"
                            Click="NextMonth_Click" ToolTip="下一月" FontSize="10"/>
                </StackPanel>
            </Grid>

            <!-- 星期头 -->
            <Grid Grid.Row="1" Margin="0,0,0,2">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="日" Foreground="#FF6B6B" FontSize="11" HorizontalAlignment="Center"/>
                <TextBlock Grid.Column="1" Text="一" Foreground="#88FFFFFF" FontSize="11" HorizontalAlignment="Center"/>
                <TextBlock Grid.Column="2" Text="二" Foreground="#88FFFFFF" FontSize="11" HorizontalAlignment="Center"/>
                <TextBlock Grid.Column="3" Text="三" Foreground="#88FFFFFF" FontSize="11" HorizontalAlignment="Center"/>
                <TextBlock Grid.Column="4" Text="四" Foreground="#88FFFFFF" FontSize="11" HorizontalAlignment="Center"/>
                <TextBlock Grid.Column="5" Text="五" Foreground="#88FFFFFF" FontSize="11" HorizontalAlignment="Center"/>
                <TextBlock Grid.Column="6" Text="六" Foreground="#FF6B6B" FontSize="11" HorizontalAlignment="Center"/>
            </Grid>

            <!-- 日期网格（6行×7列） -->
            <Grid x:Name="CalendarGrid" Grid.Row="2">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
            </Grid>

            <!-- 倒计时区域 -->
            <Border Grid.Row="3" Background="#0DFFFFFF" CornerRadius="6" Padding="8,6" Margin="0,6,0,0">
                <StackPanel x:Name="CountdownPanel">
                    <TextBlock Text="⏳ 倒计时" Foreground="#88FFFFFF" FontSize="11" Margin="0,0,0,4"/>
                </StackPanel>
            </Border>
        </Grid>
    </Border>
</local:BaseWidgetWindow>
