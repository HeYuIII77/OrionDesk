<local:BaseWidgetWindow x:Class="OrionDesk.UI.Windows.ClockWidget"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:OrionDesk.UI.Windows"
        mc:Ignorable="d"
        Title="时钟"
        Background="Transparent">
    <Window.Resources>
        <!-- 时间文本样式 -->
        <Style x:Key="TimeTextStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontFamily" Value="Segoe UI Light"/>
            <Setter Property="FontSize" Value="36"/>
            <Setter Property="FontWeight" Value="Light"/>
            <Setter Property="HorizontalAlignment" Value="Center"/>
        </Style>

        <!-- 日期文本样式 -->
        <Style x:Key="DateTextStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#CCFFFFFF"/>
            <Setter Property="FontFamily" Value="Segoe UI"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="HorizontalAlignment" Value="Center"/>
        </Style>
    </Window.Resources>

    <Border Style="{StaticResource GlassBackground}">
        <!-- 右键菜单 -->
        <Border.ContextMenu>
            <ContextMenu>
                <MenuItem Header="显示日期" Click="ToggleDate_Click" IsChecked="True"/>
                <MenuItem Header="显示农历" Click="ToggleLunar_Click" IsChecked="True"/>
                <MenuItem Header="显示天气" Click="ToggleWeather_Click" IsChecked="True"/>
                <MenuItem x:Name="WeatherDetailMenuItem" Header="天气详情" Click="ShowWeatherDetail_Click"/>
                <Separator/>
                <MenuItem x:Name="LockMenuItem" Header="锁定" Click="Lock_Click"/>
                <Separator/>
                <MenuItem Header="关闭组件" Click="Close_Click"/>
            </ContextMenu>
        </Border.ContextMenu>
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- 右上角锁定按钮 -->
            <Button x:Name="LockButton" Content="🔓" Grid.Row="0"
                    HorizontalAlignment="Left" VerticalAlignment="Center"
                    Style="{StaticResource LockButtonStyle}"
                    Click="Lock_Click" Margin="0,-6,-6,0"
                    ToolTip="锁定"
                    Panel.ZIndex="1"/>

            <!-- 数字时钟时间显示 -->
            <TextBlock x:Name="TimeText"
                       Grid.Row="0"
                       Style="{StaticResource TimeTextStyle}"
                       Text="00:00:00"/>

            <!-- 日期显示 -->
            <TextBlock x:Name="DateText"
                       Grid.Row="1"
                       Style="{StaticResource DateTextStyle}"
                       Margin="0,6,0,0"
                       Text="2026-01-01 星期四"/>

            <!-- 农历显示 -->
            <TextBlock x:Name="LunarText"
                       Grid.Row="2"
                       Style="{StaticResource DateTextStyle}"
                       Margin="0,2,0,0"
                       Text=""/>

            <!-- 天气显示 -->
            <TextBlock x:Name="WeatherText"
                       Grid.Row="3"
                       Style="{StaticResource DateTextStyle}"
                       Margin="0,4,0,0"
                       Foreground="#FF88CCFF"
                       Text=""/>
        </Grid>
    </Border>
</local:BaseWidgetWindow>
