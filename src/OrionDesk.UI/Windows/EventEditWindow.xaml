<Window x:Class="OrionDesk.UI.Windows.EventEditWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:OrionDesk.UI.Controls"
        Title="事项"
        Width="360" Height="520"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="#FF1E1E21"
        Foreground="White"
        FontFamily="Segoe UI">
    <Window.Resources>
        <Style x:Key="LabelStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#CCFFFFFF"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Margin" Value="0,0,0,6"/>
        </Style>

        <!-- 暗色 DatePicker 样式 -->
        <Style x:Key="DarkDatePickerStyle" TargetType="DatePicker">
            <Setter Property="Background" Value="#FF2D2D30"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderBrush" Value="#FF3F3F46"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Padding" Value="8,5"/>
        </Style>

        <!-- 暗色 CheckBox 样式 -->
        <Style x:Key="DarkCheckBoxStyle" TargetType="CheckBox">
            <Setter Property="Foreground" Value="#CCFFFFFF"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>

        <!-- 时间输入框样式 -->
        <Style x:Key="TimeInputStyle" TargetType="TextBox" BasedOn="{StaticResource InputStyle}">
            <Setter Property="Width" Value="60"/>
            <Setter Property="TextAlignment" Value="Center"/>
            <Setter Property="MaxLength" Value="2"/>
        </Style>
    </Window.Resources>

    <Border Background="#FF1E1E21" Padding="20">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- 标题 -->
            <TextBlock x:Name="DialogTitle" Text="添加事项" FontSize="18" FontWeight="SemiBold"
                       Foreground="White" Margin="0,0,0,16"/>

            <!-- 表单 -->
            <ScrollViewer Grid.Row="1" Style="{StaticResource DarkScrollViewerStyle}"
                          VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <StackPanel>
                    <!-- 事项标题 -->
                    <TextBlock Text="标题" Style="{StaticResource LabelStyle}"/>
                    <TextBox x:Name="TitleBox" Style="{StaticResource InputStyle}" Margin="0,0,0,14"/>

                    <!-- 日期 -->
                    <TextBlock Text="日期" Style="{StaticResource LabelStyle}"/>
                    <controls:DarkDatePicker x:Name="DatePicker" Margin="0,0,0,14"/>

                    <!-- 全天事项 -->
                    <CheckBox x:Name="AllDayCheckBox" Content="全天事项"
                              Style="{StaticResource DarkCheckBoxStyle}" Margin="0,0,0,10"
                              Checked="AllDayCheckBox_Changed" Unchecked="AllDayCheckBox_Changed"/>

                    <!-- 时间选择（非全天时显示） -->
                    <Grid x:Name="TimePanel" Margin="0,0,0,14">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <!-- 开始时间 -->
                        <TextBlock Grid.Row="0" Grid.Column="0" Text="开始"
                                   Style="{StaticResource LabelStyle}"/>
                        <StackPanel Grid.Row="1" Grid.Column="0" Orientation="Horizontal">
                            <TextBox x:Name="StartHourBox" Style="{StaticResource TimeInputStyle}" Text="09"/>
                            <TextBlock Text=":" Foreground="#88FFFFFF" FontSize="14"
                                       VerticalAlignment="Center" Margin="4,0"/>
                            <TextBox x:Name="StartMinBox" Style="{StaticResource TimeInputStyle}" Text="00"/>
                        </StackPanel>

                        <!-- 结束时间 -->
                        <TextBlock Grid.Row="0" Grid.Column="2" Text="结束"
                                   Style="{StaticResource LabelStyle}" Margin="16,0,0,0"/>
                        <StackPanel Grid.Row="1" Grid.Column="2" Orientation="Horizontal" Margin="16,0,0,0">
                            <TextBox x:Name="EndHourBox" Style="{StaticResource TimeInputStyle}" Text="10"/>
                            <TextBlock Text=":" Foreground="#88FFFFFF" FontSize="14"
                                       VerticalAlignment="Center" Margin="4,0"/>
                            <TextBox x:Name="EndMinBox" Style="{StaticResource TimeInputStyle}" Text="00"/>
                        </StackPanel>
                    </Grid>

                    <!-- 类型 -->
                    <TextBlock Text="类型" Style="{StaticResource LabelStyle}"/>
                    <controls:DarkComboBox x:Name="TypeCombo" Margin="0,0,0,14"/>

                    <!-- 重复 -->
                    <TextBlock Text="重复" Style="{StaticResource LabelStyle}"/>
                    <controls:DarkComboBox x:Name="RepeatCombo" Margin="0,0,0,14"/>

                    <!-- 备注 -->
                    <TextBlock Text="备注" Style="{StaticResource LabelStyle}"/>
                    <TextBox x:Name="NoteBox" Style="{StaticResource InputStyle}"
                             TextWrapping="Wrap" AcceptsReturn="True" Height="60"
                             VerticalScrollBarVisibility="Auto"/>
                </StackPanel>
            </ScrollViewer>

            <!-- 按钮 -->
            <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
                <Button x:Name="SaveButton" Content="保存" Style="{StaticResource ButtonStyle}"
                        Click="SaveButton_Click" Margin="0,0,8,0"/>
                <Button x:Name="DeleteButton" Content="删除" Style="{StaticResource SecondaryButtonStyle}"
                        Click="DeleteButton_Click" Margin="0,0,8,0" Visibility="Collapsed"/>
                <Button Content="取消" Style="{StaticResource SecondaryButtonStyle}"
                        Click="CancelButton_Click"/>
            </StackPanel>
        </Grid>
    </Border>
</Window>
