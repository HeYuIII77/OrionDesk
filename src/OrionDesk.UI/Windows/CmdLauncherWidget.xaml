<local:BaseWidgetWindow x:Class="OrionDesk.UI.Windows.CmdLauncherWidget"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:OrionDesk.UI.Windows"
        Title="CMD"
        Background="Transparent">
    <Border Style="{StaticResource GlassBackground}">
        <Border.ContextMenu>
            <ContextMenu>
                <MenuItem Header="设置" Click="SetCommand_Click"/>
                <Separator/>
                <MenuItem x:Name="LockMenuItem" Header="锁定" Click="Lock_Click"/>
                <Separator/>
                <MenuItem Header="关闭组件" Click="Close_Click"/>
            </ContextMenu>
        </Border.ContextMenu>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- 标题栏 -->
            <Grid Grid.Row="0" Margin="0,0,0,4">
                <Button x:Name="LockButton" Content="🔓"
                        HorizontalAlignment="Left" VerticalAlignment="Center"
                        Style="{StaticResource LockButtonStyle}"
                        Click="Lock_Click" ToolTip="锁定"/>
                <TextBlock x:Name="TitleText" Text="⚡ AI"
                           Foreground="White" FontSize="12"
                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Grid>

            <!-- 大图标按钮 -->
            <Button x:Name="LaunchButton" Grid.Row="1"
                    Background="Transparent" BorderThickness="0" Cursor="Hand"
                    Click="LaunchButton_Click" ToolTip="点击启动">
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                    <!-- 图标容器：灰色圆角背景 -->
                    <Border x:Name="IconBg" Background="#FF3F3F46" CornerRadius="16"
                            Width="72" Height="72"
                            HorizontalAlignment="Center">
                        <TextBlock x:Name="IconText" Text="🖥" FontSize="36"
                                   Foreground="White"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <TextBlock x:Name="CommandText" Text="右键设置"
                               Foreground="#88FFFFFF" FontSize="11"
                               HorizontalAlignment="Center" Margin="0,6,0,0"/>
                </StackPanel>
            </Button>
        </Grid>
    </Border>
</local:BaseWidgetWindow>
