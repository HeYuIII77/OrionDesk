<Window x:Class="OrionDesk.UI.Windows.QuickToolEditWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:OrionDesk.UI.Controls"
        Title="添加快捷工具"
        Width="400" Height="420"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="#FF1E1E21"
        Foreground="White"
        FontFamily="Segoe UI">
    <Window.Resources>
        <Style x:Key="LabelStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#CCFFFFFF"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Margin" Value="0,0,0,6"/>
        </Style>
    </Window.Resources>

    <Border Background="#FF1E1E21" Padding="24">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- 标题 -->
            <TextBlock x:Name="DialogTitle" Text="添加快捷工具" FontSize="18" FontWeight="SemiBold"
                       Foreground="White" Margin="0,0,0,16"/>

            <!-- 表单内容 -->
            <ScrollViewer Grid.Row="1" Style="{StaticResource DarkScrollViewerStyle}"
                          VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled">
                <StackPanel>
                    <!-- 名称 -->
                    <TextBlock Text="名称" Style="{StaticResource LabelStyle}"/>
                    <TextBox x:Name="NameBox" Style="{StaticResource InputStyle}" Margin="0,0,0,12"/>

                    <!-- 图标 -->
                    <TextBlock Text="图标（emoji 或留空使用默认图标）" Style="{StaticResource LabelStyle}"/>
                    <TextBox x:Name="IconBox" Style="{StaticResource InputStyle}" Margin="0,0,0,12"
                             Width="60" HorizontalAlignment="Left"/>

                    <!-- 类型 -->
                    <TextBlock Text="类型" Style="{StaticResource LabelStyle}"/>
                    <controls:DarkComboBox x:Name="TypeCombo" Margin="0,0,0,12"/>

                    <!-- 路径 -->
                    <TextBlock x:Name="PathLabel" Text="程序路径" Style="{StaticResource LabelStyle}"/>
                    <Grid Margin="0,0,0,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBox x:Name="PathBox" Grid.Column="0" Style="{StaticResource InputStyle}"/>
                        <Button x:Name="BrowseButton" Grid.Column="1" Content="..."
                                Style="{StaticResource SecondaryButtonStyle}"
                                Padding="10,5" Margin="8,0,0,0"
                                Click="BrowseButton_Click"/>
                    </Grid>

                    <!-- 参数 -->
                    <TextBlock x:Name="ArgsLabel" Text="启动参数" Style="{StaticResource LabelStyle}"/>
                    <TextBox x:Name="ArgsBox" Style="{StaticResource InputStyle}" Margin="0,0,0,12"/>

                    <!-- 管理员权限 -->
                    <CheckBox x:Name="AdminCheckBox" Content="以管理员身份启动"
                              Foreground="#CCFFFFFF" FontSize="12" Margin="0,0,0,4"/>
                </StackPanel>
            </ScrollViewer>

            <!-- 按钮 -->
            <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
                <Button x:Name="OkButton" Content="确定" Style="{StaticResource ButtonStyle}"
                        Click="OkButton_Click" Margin="0,0,8,0"/>
                <Button Content="取消" Style="{StaticResource SecondaryButtonStyle}"
                        Click="CancelButton_Click"/>
            </StackPanel>
        </Grid>
    </Border>
</Window>
