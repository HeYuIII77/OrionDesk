<Window x:Class="OrionDesk.UI.Windows.EventListWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="事项列表"
        Width="320" Height="400"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="#FF1E1E21"
        Foreground="White"
        FontFamily="Segoe UI">
    <Border Background="#FF1E1E21" Padding="16">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- 标题 -->
            <TextBlock x:Name="TitleText" FontSize="16" FontWeight="SemiBold"
                       Foreground="White" Margin="0,0,0,12"/>

            <!-- 事项列表 -->
            <ScrollViewer Grid.Row="1" Style="{StaticResource DarkScrollViewerStyle}"
                          VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <StackPanel x:Name="EventPanel"/>
            </ScrollViewer>

            <!-- 添加按钮 -->
            <Button Grid.Row="2" x:Name="AddButton" Content="＋ 添加事项"
                    Style="{StaticResource ButtonStyle}"
                    HorizontalAlignment="Stretch" Margin="0,12,0,0"
                    Click="AddButton_Click"/>
        </Grid>
    </Border>
</Window>
