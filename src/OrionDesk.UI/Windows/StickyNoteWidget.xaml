<local:BaseWidgetWindow x:Class="OrionDesk.UI.Windows.StickyNoteWidget"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:OrionDesk.UI.Windows"
        mc:Ignorable="d"
        Title="便签"
        Background="Transparent">
    <Window.Resources>
        <!-- 背景样式 -->
        <Style x:Key="GlassBackground" TargetType="Border">
            <Setter Property="CornerRadius" Value="10"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="10"/>
        </Style>

        <!-- 文本框样式 -->
        <Style x:Key="NoteTextBoxStyle" TargetType="TextBox">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#FF333333"/>
            <Setter Property="FontFamily" Value="Segoe UI"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="AcceptsReturn" Value="True"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="VerticalScrollBarVisibility" Value="Auto"/>
            <Setter Property="CaretBrush" Value="#FF333333"/>
            <Setter Property="Padding" Value="5"/>
        </Style>
    </Window.Resources>

    <Border x:Name="NoteBorder" Background="#FFFACD" CornerRadius="10">
        <!-- 右键菜单 -->
        <Border.ContextMenu>
            <ContextMenu>
                <MenuItem Header="颜色">
                    <MenuItem Header="黄色" Click="ColorYellow_Click">
                        <MenuItem.Icon>
                            <Rectangle Width="16" Height="16" Fill="#FFFACD" Stroke="#FF999999" StrokeThickness="1" RadiusX="2" RadiusY="2"/>
                        </MenuItem.Icon>
                    </MenuItem>
                    <MenuItem Header="粉色" Click="ColorPink_Click">
                        <MenuItem.Icon>
                            <Rectangle Width="16" Height="16" Fill="#FFFFB6C1" Stroke="#FF999999" StrokeThickness="1" RadiusX="2" RadiusY="2"/>
                        </MenuItem.Icon>
                    </MenuItem>
                    <MenuItem Header="蓝色" Click="ColorBlue_Click">
                        <MenuItem.Icon>
                            <Rectangle Width="16" Height="16" Fill="#FFADD8E6" Stroke="#FF999999" StrokeThickness="1" RadiusX="2" RadiusY="2"/>
                        </MenuItem.Icon>
                    </MenuItem>
                    <MenuItem Header="绿色" Click="ColorGreen_Click">
                        <MenuItem.Icon>
                            <Rectangle Width="16" Height="16" Fill="#FF90EE90" Stroke="#FF999999" StrokeThickness="1" RadiusX="2" RadiusY="2"/>
                        </MenuItem.Icon>
                    </MenuItem>
                </MenuItem>
                <Separator/>
                <MenuItem x:Name="LockMenuItem" Header="锁定" Click="Lock_Click"/>
                <Separator/>
                <MenuItem Header="删除便签" Click="Delete_Click"/>
            </ContextMenu>
        </Border.ContextMenu>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- 顶部拖拽条 -->
            <Border x:Name="TitleBar" Grid.Row="0" Height="24" Background="Transparent">
                <Grid>
                    <!-- 锁定按钮 -->
                    <Button x:Name="LockButton" Content="🔓"
                            HorizontalAlignment="Left" VerticalAlignment="Center"
                            Width="20" Height="20" FontSize="10"
                            Background="Transparent" Foreground="#66333333" BorderThickness="0"
                            Cursor="Hand" Click="Lock_Click"
                            ToolTip="锁定"/>
                    <!-- 删除按钮 -->
                    <Button x:Name="DeleteButton" Content="×" HorizontalAlignment="Right"
                            Width="20" Height="20" FontSize="14" FontWeight="Bold"
                            Background="Transparent" Foreground="#66333333" BorderThickness="0"
                            Cursor="Hand" Click="Delete_Click" VerticalAlignment="Center"/>
                </Grid>
            </Border>

            <!-- 文本输入区域 -->
            <TextBox x:Name="NoteTextBox" Grid.Row="1"
                     Style="{StaticResource NoteTextBoxStyle}"
                     TextChanged="NoteTextBox_TextChanged"/>
        </Grid>
    </Border>
</local:BaseWidgetWindow>
