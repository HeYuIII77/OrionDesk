<Window x:Class="OrionDesk.UI.Windows.DiagnosticsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="OrionDesk 诊断监控"
        Width="520" Height="560"
        MinWidth="480" MinHeight="400"
        WindowStartupLocation="CenterScreen"
        ResizeMode="CanResizeWithGrip"
        Background="#FF1E1E21"
        Foreground="White"
        FontFamily="Segoe UI">
    <Window.Resources>
        <!-- 分组标题 -->
        <Style x:Key="SectionTitle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#FF88CCFF"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Margin" Value="0,0,0,8"/>
        </Style>

        <!-- 指标标签 -->
        <Style x:Key="MetricLabel" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#88FFFFFF"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="MinWidth" Value="95"/>
        </Style>

        <!-- 指标值 -->
        <Style x:Key="MetricValue" TargetType="TextBlock">
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>
    </Window.Resources>

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- 当前快照面板 -->
        <Border Grid.Row="0" Background="#1AFFFFFF" CornerRadius="8" Padding="14" Margin="0,0,0,12">
            <StackPanel>
                <Grid>
                    <TextBlock Text="📊 当前快照" Style="{StaticResource SectionTitle}"/>
                    <TextBlock x:Name="TimestampText" Text=""
                               Foreground="#88FFFFFF" FontSize="11"
                               HorizontalAlignment="Right" VerticalAlignment="Center"/>
                </Grid>

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- 左列 -->
                    <StackPanel Grid.Row="0" Grid.Column="0" Orientation="Horizontal" Margin="0,0,0,6">
                        <TextBlock Text="工作集内存:" Style="{StaticResource MetricLabel}"/>
                        <TextBlock x:Name="WorkingSetText" Text="-" Style="{StaticResource MetricValue}"/>
                    </StackPanel>
                    <StackPanel Grid.Row="1" Grid.Column="0" Orientation="Horizontal" Margin="0,0,0,6">
                        <TextBlock Text="私有内存:" Style="{StaticResource MetricLabel}"/>
                        <TextBlock x:Name="PrivateMemoryText" Text="-" Style="{StaticResource MetricValue}"/>
                    </StackPanel>
                    <StackPanel Grid.Row="2" Grid.Column="0" Orientation="Horizontal" Margin="0,0,0,6">
                        <TextBlock Text="托管堆:" Style="{StaticResource MetricLabel}"/>
                        <TextBlock x:Name="ManagedHeapText" Text="-" Style="{StaticResource MetricValue}"/>
                    </StackPanel>
                    <StackPanel Grid.Row="3" Grid.Column="0" Orientation="Horizontal" Margin="0,0,0,6">
                        <TextBlock Text="GDI 句柄:" Style="{StaticResource MetricLabel}"/>
                        <TextBlock x:Name="GdiHandlesText" Text="-" Style="{StaticResource MetricValue}"/>
                    </StackPanel>
                    <StackPanel Grid.Row="4" Grid.Column="0" Orientation="Horizontal" Margin="0,0,0,0">
                        <TextBlock Text="USER 句柄:" Style="{StaticResource MetricLabel}"/>
                        <TextBlock x:Name="UserHandlesText" Text="-" Style="{StaticResource MetricValue}"/>
                    </StackPanel>

                    <!-- 右列 -->
                    <StackPanel Grid.Row="0" Grid.Column="1" Orientation="Horizontal" Margin="0,0,0,6">
                        <TextBlock Text="内核句柄:" Style="{StaticResource MetricLabel}"/>
                        <TextBlock x:Name="HandleCountText" Text="-" Style="{StaticResource MetricValue}"/>
                    </StackPanel>
                    <StackPanel Grid.Row="1" Grid.Column="1" Orientation="Horizontal" Margin="0,0,0,6">
                        <TextBlock Text="线程数:" Style="{StaticResource MetricLabel}"/>
                        <TextBlock x:Name="ThreadCountText" Text="-" Style="{StaticResource MetricValue}"/>
                    </StackPanel>
                    <StackPanel Grid.Row="2" Grid.Column="1" Orientation="Horizontal" Margin="0,0,0,6">
                        <TextBlock Text="GC Gen0:" Style="{StaticResource MetricLabel}"/>
                        <TextBlock x:Name="Gen0Text" Text="-" Style="{StaticResource MetricValue}"/>
                    </StackPanel>
                    <StackPanel Grid.Row="3" Grid.Column="1" Orientation="Horizontal" Margin="0,0,0,6">
                        <TextBlock Text="GC Gen1:" Style="{StaticResource MetricLabel}"/>
                        <TextBlock x:Name="Gen1Text" Text="-" Style="{StaticResource MetricValue}"/>
                    </StackPanel>
                    <StackPanel Grid.Row="4" Grid.Column="1" Orientation="Horizontal" Margin="0,0,0,0">
                        <TextBlock Text="GC Gen2:" Style="{StaticResource MetricLabel}"/>
                        <TextBlock x:Name="Gen2Text" Text="-" Style="{StaticResource MetricValue}"/>
                    </StackPanel>
                </Grid>
            </StackPanel>
        </Border>

        <!-- 趋势列表 -->
        <Border Grid.Row="1" Background="#1AFFFFFF" CornerRadius="8" Padding="14" Margin="0,0,0,12">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <Grid Grid.Row="0">
                    <TextBlock Text="📈 趋势历史" Style="{StaticResource SectionTitle}"/>
                    <TextBlock x:Name="HistoryCountText" Text=""
                               Foreground="#88FFFFFF" FontSize="11"
                               HorizontalAlignment="Right" VerticalAlignment="Center"/>
                </Grid>

                <ScrollViewer Grid.Row="1" Style="{StaticResource DarkScrollViewerStyle}"
                              VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto">
                    <Grid>
                        <!-- 表头 -->
                        <Grid x:Name="HeaderRow" Margin="0,0,0,4">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="70"/>
                                <ColumnDefinition Width="60"/>
                                <ColumnDefinition Width="60"/>
                                <ColumnDefinition Width="50"/>
                                <ColumnDefinition Width="50"/>
                                <ColumnDefinition Width="50"/>
                                <ColumnDefinition Width="40"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="时间" Foreground="#88FFFFFF" FontSize="11" FontWeight="SemiBold"/>
                            <TextBlock Grid.Column="1" Text="内存MB" Foreground="#88FFFFFF" FontSize="11" FontWeight="SemiBold"/>
                            <TextBlock Grid.Column="2" Text="堆MB" Foreground="#88FFFFFF" FontSize="11" FontWeight="SemiBold"/>
                            <TextBlock Grid.Column="3" Text="GDI" Foreground="#88FFFFFF" FontSize="11" FontWeight="SemiBold"/>
                            <TextBlock Grid.Column="4" Text="USER" Foreground="#88FFFFFF" FontSize="11" FontWeight="SemiBold"/>
                            <TextBlock Grid.Column="5" Text="句柄" Foreground="#88FFFFFF" FontSize="11" FontWeight="SemiBold"/>
                            <TextBlock Grid.Column="6" Text="线程" Foreground="#88FFFFFF" FontSize="11" FontWeight="SemiBold"/>
                        </Grid>

                        <!-- 数据行容器 -->
                        <StackPanel x:Name="HistoryRows" Margin="0,20,0,0"/>
                    </Grid>
                </ScrollViewer>
            </Grid>
        </Border>

        <!-- 底部操作栏 -->
        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <Button x:Name="TakeSnapshotButton" Content="手动采集"
                    Style="{StaticResource ButtonStyle}"
                    Padding="12,6" FontSize="12"
                    Click="TakeSnapshot_Click"/>

            <Button x:Name="OpenLogDirButton" Content="打开日志目录"
                    Style="{StaticResource SecondaryButtonStyle}"
                    Padding="12,6" FontSize="12"
                    HorizontalAlignment="Right"
                    Click="OpenLogDir_Click"/>
        </Grid>
    </Grid>
</Window>
