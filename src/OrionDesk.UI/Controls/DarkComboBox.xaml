<UserControl x:Class="OrionDesk.UI.Controls.DarkComboBox"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="Transparent">
    <Grid>
        <Border x:Name="MainBorder" Background="#FF2D2D30" BorderBrush="#FF3F3F46"
                BorderThickness="1" CornerRadius="6" Padding="0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- 选中项显示 -->
                <TextBlock x:Name="DisplayText" Grid.Column="0"
                           Foreground="White" FontSize="13"
                           VerticalAlignment="Center"
                           Margin="10,6,4,6"
                           TextTrimming="CharacterEllipsis"/>

                <!-- 下拉箭头 -->
                <ToggleButton x:Name="DropdownToggle" Grid.Column="1"
                              Background="Transparent" BorderThickness="0"
                              Width="24" Cursor="Hand"
                              IsChecked="{Binding IsOpen, ElementName=Popup}"
                              Focusable="False">
                    <TextBlock x:Name="ArrowText" Text="▼" Foreground="#88FFFFFF"
                               FontSize="9" HorizontalAlignment="Center"
                               VerticalAlignment="Center"/>
                </ToggleButton>
            </Grid>
        </Border>

        <!-- 下拉弹出层 -->
        <Popup x:Name="Popup" Placement="Bottom" PlacementTarget="{Binding ElementName=MainBorder}"
               IsOpen="False" AllowsTransparency="True" Focusable="False"
               PopupAnimation="Slide" StaysOpen="False"
               VerticalOffset="2">
            <Border x:Name="PopupBorder" Background="#FF2D2D30" BorderBrush="#FF3F3F46"
                    BorderThickness="1" CornerRadius="4" MaxHeight="200" MinWidth="{Binding ActualWidth, ElementName=MainBorder}">
                <ListBox x:Name="ItemList" Background="Transparent" BorderThickness="0"
                         Foreground="White" FontSize="13"
                         Padding="2" Margin="0"
                         SelectionChanged="ItemList_SelectionChanged"
                         ItemContainerStyle="{StaticResource DarkComboBoxItemStyle}"/>
            </Border>
        </Popup>
    </Grid>
</UserControl>
