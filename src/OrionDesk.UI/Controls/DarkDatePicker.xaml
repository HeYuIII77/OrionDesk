<UserControl x:Class="OrionDesk.UI.Controls.DarkDatePicker"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="Transparent">
    <Grid>
        <Border x:Name="MainBorder" Background="#FF2D2D30" BorderBrush="#FF3F3F46"
                BorderThickness="1" CornerRadius="6" Padding="0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- 日期文本 -->
                <TextBox x:Name="DateTextBox" Grid.Column="0"
                         Background="Transparent" Foreground="White"
                         BorderThickness="0" FontSize="13"
                         Padding="10,6,4,6" CaretBrush="White"
                         VerticalContentAlignment="Center"
                         LostFocus="DateTextBox_LostFocus"
                         KeyDown="DateTextBox_KeyDown"/>

                <!-- 日历按钮 -->
                <ToggleButton x:Name="CalendarToggle" Grid.Column="1"
                              Background="Transparent" BorderThickness="0"
                              Width="28" Cursor="Hand" Focusable="False"
                              Click="CalendarToggle_Click">
                    <TextBlock Text="📅" FontSize="13"
                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </ToggleButton>
            </Grid>
        </Border>

        <!-- 日历弹出层 -->
        <Popup x:Name="CalendarPopup" Placement="Bottom" PlacementTarget="{Binding ElementName=MainBorder}"
               IsOpen="False" AllowsTransparency="True" Focusable="False"
               PopupAnimation="Slide" StaysOpen="False" VerticalOffset="2">
            <Border Background="#FF2D2D30" BorderBrush="#FF3F3F46" BorderThickness="1"
                    CornerRadius="6" Padding="6">
                <Calendar x:Name="CalendarControl"
                          Background="Transparent" Foreground="White"
                          BorderThickness="0"
                          FontFamily="Segoe UI" FontSize="12"
                          SelectedDatesChanged="CalendarControl_SelectedDatesChanged"
                          DisplayDateChanged="CalendarControl_DisplayDateChanged">
                    <Calendar.Resources>
                        <!-- 日历整体背景 -->
                        <Style TargetType="Calendar">
                            <Setter Property="Background" Value="#FF2D2D30"/>
                            <Setter Property="Foreground" Value="White"/>
                        </Style>
                    </Calendar.Resources>
                </Calendar>
            </Border>
        </Popup>
    </Grid>
</UserControl>
